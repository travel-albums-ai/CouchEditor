{
  "name": "CouchEditor",
  "private": true,
  "version": "1.130.0",
  "type": "module",
  "scripts": {
    "#-----RUNNING------": "",
    "dev": "vite",
    "#-----BUILDING------": "",
    "build": "vite build --mode production",
    "postbuild": "node ./scripts/build-sw.cjs",
    "copy:dist": "cp -r ./dist/* ../trip-gallery-builder/resources/",
    "prepare:build": "npm run build && npm run copy:dist",
    "#-----UTILS------": "",
    "analyze": "VITE_BUNDLE_VISUALIZE=true vite build",
    "lint": "eslint .",
    "knip": "knip",
    "next": "semantic-release",
    "package": "npm run prepare:build",
    "preview": "npm run build && vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.102.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.11.6",
    "driver.js": "^1.8.0",
    "exifr": "^7.1.3",
    "flexlayout-react": "^0.11.0",
    "i18next": "^26.4.2",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-virtuoso": "^4.18.13",
    "string-to-color": "^2.2.2",
    "uplot": "^1.6.32",
    "workbox-window": "^6.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "knip": "^6.35.1",
    "rollup-plugin-visualizer": "latest",
    "semantic-release": "^24.2.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "workbox-build": "^6.6.1"
  }
